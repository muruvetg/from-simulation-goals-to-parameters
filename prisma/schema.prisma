// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Prompt {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prompts")
}

model ChatSession {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]

  @@map("chat_sessions")
}

model Message {
  id            String      @id @default(cuid())
  role          String      // 'user' or 'assistant'
  content       String      @db.Text
  model         String?     // OpenAI model used
  createdAt     DateTime    @default(now())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model TestBatch {
  id          String   @id @default(cuid())
  name        String
  testMessage String   @db.Text
  groundTruth String?  @db.Text
  estimatedGroundTruthParams Int? @default(1)  // For recall calculation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  runs        TestRun[]

  @@map("test_batches")
}

model TestRun {
  id                String    @id @default(cuid())
  sessionId         String?   // Link to chat session if created
  model             String
  prompt            String
  promptId          String
  iteration         Int
  status            String    // 'pending', 'running', 'completed', 'error'
  startTime         DateTime?
  endTime           DateTime?
  error             String?   @db.Text
  response          String?   @db.Text
  groundTruthMatch  String?   // 'good', 'bad', 'neutral'
  notes             String?   @db.Text
  parametersRecommended Int?  // Number of parameters recommended by model
  correctParameters Float?    // Number of correct parameters (can be decimal)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  testBatchId       String
  testBatch         TestBatch @relation(fields: [testBatchId], references: [id], onDelete: Cascade)

  @@map("test_runs")
}
